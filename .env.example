# LOCAL ONLY: create this role/database and replace this sample password.
APP_NAME="Personal Todo API"
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://todo_app:change_me_local_only@localhost:5432/todo_dev
SESSION_TTL_SECONDS=86400
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
PASSWORD_CONCURRENCY=2
# Lists use JSON syntax. Add your actual public hostname before deployment.
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
CORS_ORIGINS=[]
# All limits are active and shared through PostgreSQL.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
ACCOUNT_RATE_LIMIT_REQUESTS=10
ACCOUNT_RATE_LIMIT_WINDOW_SECONDS=300
